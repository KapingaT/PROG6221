<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="CybersecurityChatbotWPF.MainWindow"
        Title="Cybersecurity Awareness Chatbot" 
        Height="900" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#B0D4E8">

    <Window.Resources>
        <!-- Chat bubble styles -->
        <Style x:Key="UserBubbleStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#4A90D9"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="5,2,50,2"/>
            <Setter Property="MaxWidth" Value="550"/>
        </Style>

        <Style x:Key="BotBubbleStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#2D2D3F"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="50,2,5,2"/>
            <Setter Property="MaxWidth" Value="550"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#4A90D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5BA0E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopicButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#3D3D50"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25,15,5,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SUPER LARGE ASCII ART HEADER -->
        <Border Grid.Row="0" Background="#2D2D3F" CornerRadius="10" Padding="15" Margin="10,-26,-10,41">
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontFamily="Consolas" Foreground="#4A90D9" FontSize="12"
               Text="╔════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╗"
               TextAlignment="Center"/>

                    <TextBlock FontFamily="Consolas" Foreground="#FF6B6B" FontSize="18" FontWeight="Bold"
               Text="║                                      W E L C O M E   T O   T H E                                               ║"
               TextAlignment="Center"/>

                    <TextBlock FontFamily="Consolas" Foreground="#FF6B6B" FontSize="20" FontWeight="Bold"
               Text="║                           C Y B E R S E C U R I T Y   A W A R E N E S S   B O T                                 ║"
               TextAlignment="Center"/>

                    <TextBlock FontFamily="Consolas" Foreground="#4A90D9" FontSize="12"
               Text="╠════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╣"
               TextAlignment="Center"/>

                    <!-- Large Shield Art -->
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                    ________________________________________________                                    ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                   /                                                  \                                   ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                  /                                                    \                                  ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                 |                                                      |                                 ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                 |        ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄          |                                 ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                 |       █                                █         |                                 ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                 |       █     S E C U R I T Y   B O T     █         |                                 ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                 |       █                                █         |                                 ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                 |       █     Y O U R   S H I E L D       █         |                                 ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                 |       █                                █         |                                 ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                 |       █▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄█         |                                 ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                 |                                                      |                                 ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                  \                                                    /                                  ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                   \                                                  /                                   ║"
               TextAlignment="Left"/>
                    <TextBlock FontFamily="Consolas" Foreground="#5BA0E9" FontSize="11"
               Text="║                                                    ________________________________________________                                    ║"
               TextAlignment="Left"/>

                    <TextBlock FontFamily="Consolas" Foreground="#4A90D9" FontSize="12" Margin="0,10,0,0"
               Text="╠════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╣"
               TextAlignment="Center"/>

                    <TextBlock FontFamily="Consolas" Foreground="#A0A0A0" FontSize="14" FontWeight="Bold"
               Text="║                                     P R O T E C T I N G   Y O U   T O D A Y   A N D   T O M O R R O W                                        ║"
               TextAlignment="Center"/>

                    <TextBlock FontFamily="Consolas" Foreground="#87CEEB" FontSize="12"
               Text="║                                   Your Digital Guardian - Available 24/7 to Keep You Safe                                                       ║"
               TextAlignment="Center"/>

                    <TextBlock FontFamily="Consolas" Foreground="#4A90D9" FontSize="12"
               Text="╚════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════╝"
               TextAlignment="Center"/>

                    <TextBlock FontFamily="Consolas" Foreground="#FFD700" FontSize="11" FontWeight="Bold" Margin="0,10,0,0"
               Text="                                          S T A Y   V I G I L A N T   -   S T A Y   I N F O R M E D   -   S T A Y   P R O T E C T E D                                 "
               TextAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <!-- Name Input Panel -->
        <Border x:Name="NameInputPanel" Grid.Row="1" Background="#2D2D3F" CornerRadius="10" 
                Padding="20" Margin="0,0,0,35" Visibility="Visible">
            <StackPanel>
                <TextBlock Text="Welcome! Please tell me your name:" Foreground="White" 
                           FontSize="16" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NameTextBox" Grid.Column="0" Background="#1E1E2E" 
                             Foreground="White" BorderBrush="#4A90D9" BorderThickness="3"
                             FontSize="14" Padding="12" MinHeight="45"/>
                    <Button x:Name="SubmitNameButton" Grid.Column="1" Content="Start Chat" 
                            Width="120" Click="SubmitNameButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Chat Display Area -->
        <ListBox x:Name="ChatListBox" Grid.Row="1" Background="#1E1E2E" 
                 BorderThickness="0" Margin="0,159,0,5" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.RowSpan="2" SelectionChanged="ChatListBox_SelectionChanged" RenderTransformOrigin="0.5,0.5">
            <ListBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.595"/>
                    <RotateTransform/>
                    <TranslateTransform X="0.74"/>
                </TransformGroup>
            </ListBox.RenderTransform>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="{Binding Alignment}" 
                                Margin="0,5">
                        <Border Style="{Binding BubbleStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Sender}" Foreground="#888888" 
                                           FontSize="11" Margin="5,0,5,3"/>
                                <TextBlock Text="{Binding Text}" Foreground="White" 
                                           FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Timestamp}" Foreground="#666666" 
                                           FontSize="9" Margin="5,3,5,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Input Area -->
        <Border Grid.Row="3" Background="#2D2D3F" CornerRadius="10" Padding="12" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTextBox" Grid.Column="0" Background="#1E1E2E" 
                         Foreground="White" BorderBrush="#4A90D9" BorderThickness="2"
                         FontSize="14" Padding="12" MinHeight="45"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         KeyDown="MessageTextBox_KeyDown"/>

                <Button x:Name="SendButton" Grid.Column="1" Content="SEND" 
                        Width="90" Click="SendButton_Click"/>

                <Button x:Name="VoiceButton" Grid.Column="2" Content="🎤" 
                        Width="60" Click="VoiceButton_Click"/>
            </Grid>
        </Border>

        <!-- Quick Topic Buttons -->
        <WrapPanel Grid.Row="4" Margin="0,15,0,0" HorizontalAlignment="Center">
            <Button Style="{StaticResource TopicButtonStyle}" Content="Passwords" 
                    Click="QuickTopic_Click" Tag="Tell me about passwords" Height="112" Width="127"/>
            <Button Style="{StaticResource TopicButtonStyle}" Content="Phishing" 
                    Click="QuickTopic_Click" Tag="Give me a phishing tip" Height="114" Width="98"/>
            <Button Style="{StaticResource TopicButtonStyle}" Content="Malware" 
                    Click="QuickTopic_Click" Tag="What is malware?"/>
            <Button Style="{StaticResource TopicButtonStyle}" Content="Ransomware" 
                    Click="QuickTopic_Click" Tag="What is ransomware?"/>
            <Button Style="{StaticResource TopicButtonStyle}" Content="2FA" 
                    Click="QuickTopic_Click" Tag="What is two factor authentication?"/>
            <Button Style="{StaticResource TopicButtonStyle}" Content="Firewall" 
                    Click="QuickTopic_Click" Tag="What is a firewall?"/>
            <Button Style="{StaticResource TopicButtonStyle}" Content="Privacy" 
                    Click="QuickTopic_Click" Tag="I'm interested in privacy"/>
            <Button Style="{StaticResource TopicButtonStyle}" Content="Help" 
                    Click="QuickTopic_Click" Tag="help"/>
            <Button Style="{StaticResource TopicButtonStyle}" Content="Clear Chat" 
                    Click="ClearChat_Click"/>
        </WrapPanel>
    </Grid>
</Window>